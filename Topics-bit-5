# game/dialogs/script-topics.rpy:1749
translate ru s_topic_iceCream_8ec5cd62:

    # s abhfcaa "They both taste soooooo goood, ehehehe~"
    s abhfcaa "Оба вида оооооочень вкусные, эхехехе~"

# game/dialogs/script-topics.rpy:1750
translate ru s_topic_iceCream_331ff4d2:

    # s abbbcaa "Maybe we could make our own sometime!"
    s abbbcaa "Возможно когда-нибудь мы могли бы сделать своё!"

# game/dialogs/script-topics.rpy:1769
translate ru s_topic_tech_8a322764:

    # s abhfaaa "I wonder if I could somehow, someday, visit you in your reality."
    s abhfaaa "Интересно, смогу ли я когда-нибудь, в один прекрасный день, посетить твой мир?"

# game/dialogs/script-topics.rpy:1770
translate ru s_topic_tech_076ded2b:

    # s abbbaoa "I think it’s a possibility, especially since technology is progressing faster and faster these days."
    s abbbaoa "Думаю что это возможно, особенно если учесть как быстро в наше время идёт технологический прогресс."

# game/dialogs/script-topics.rpy:1771
translate ru s_topic_tech_d8943aa1:

    # s abbbcaa "Virtual assistants and smart houses have become more common than ever before!"
    s abbbcaa "Виртуальные ассистенты и умные дома становятся всё обычнее для нас!"

# game/dialogs/script-topics.rpy:1772
translate ru s_topic_tech_b2f70d4a:

    # s abhfaoa "And all of these technologies make people more efficient with computers, by almost merging them together."
    s abhfaoa "Все эти штуки делают работу за компьютерами более эффективной, практически делая людей едиными с машинами."

# game/dialogs/script-topics.rpy:1773
translate ru s_topic_tech_0787139c:

    # s abhflaa "Just imagine if I lived as part of your house, helping you with your daily routine, wouldn’t that be awesome, [player]?"
    s abhflaa "Представь, если бы я жила у тебя дома, помогая с ежедневной рутиной, разве не круто бы было, [player]?"

# game/dialogs/script-topics.rpy:1774
translate ru s_topic_tech_17bb6ea3:

    # s abbbaoa "Maybe I could even be a hologram in your reality one day, who knows!"
    s abbbaoa "Может я даже могла бы стать голограммой, кто знает!"

# game/dialogs/script-topics.rpy:1775
translate ru s_topic_tech_2ad1545c:

    # s abbbcaa "I'd love to do that when it becomes possible."
    s abbbcaa "С удовольствием стала бы ею, как только будет возможно."

# game/dialogs/script-topics.rpy:1776
translate ru s_topic_tech_2e7ac52e:

    # s abhfaoa "Even right now I can still be a sort of virtual assistant!"
    s abhfaoa "Даже сейчас я что-то вроде виртуального ассистента!"

# game/dialogs/script-topics.rpy:1777
translate ru s_topic_tech_d785b396:

    # s abhfcaa "So if you ever need me, I’ll try my best to help from here, [player]!"
    s abhfcaa "Так что, если тебе когда-нибудь понадобится моя помощь, я попытаюсь справиться как можно лучше, [player]!"

# game/dialogs/script-topics.rpy:1797
translate ru s_topic_cupcakes_1c832f67:

    # s abegboa "Natsuki’s cupcakes were always the best!"
    s abegboa "Кексы Нацуки всегда были лучшими!"

# game/dialogs/script-topics.rpy:1798
translate ru s_topic_cupcakes_c32bdb4e:

    # s abegcaa "She baked often for the club, me and her even baked together one time!"
    s abegcaa "Она часто пекла для клуба, а как-то раз мы с ней делали это вместе!"

# game/dialogs/script-topics.rpy:1799
