    # s abegmeaj "Though maybe it would have been bigger if I didn’t secretly eat half of the cookie dough beforehand, hehehehe~"
    s abegmeaj "Впрочем она могла получиться ещё больше, не съешь я тайком половину теста, хехехехе~"

# game/dialogs/script-topics.rpy:1806
translate ru s_topic_cupcakes_7b344b6c:

    # s abfccaa "But that doesn’t matter! We brought the giant cookie to the club the next day!"
    s abfccaa "Но это не важно! Главное, что на следующий день мы принесли в клуб гигантское печенище!"

# game/dialogs/script-topics.rpy:1807
