    # s abhfaoa "We were making cookies, so she made the cookie dough and then I separated it into little cookie shapes..."
    s abhfaoa "Мы делали печеньки, она раскатала тесто, и потом я поделила его на небольшие заготовки..."

# game/dialogs/script-topics.rpy:1800
translate ru s_topic_cupcakes_aabd9331:

    # s fbbbaaa "...but I had a better idea!"
    s fbbbaaa "...но мне пришла идея получше!"

# game/dialogs/script-topics.rpy:1801
translate ru s_topic_cupcakes_cec5ef0b:

    # s fbbbaoa "I combined all the cookie dough together into..."
    s fbbbaoa "Я соеденила всё тесто в..."

# game/dialogs/script-topics.rpy:1802
translate ru s_topic_cupcakes_dd1af139:

    # s fbbbaaa "One."
    s fbbbaaa "Одну."

# game/dialogs/script-topics.rpy:1803
translate ru s_topic_cupcakes_d982f3a6:

    # s fbbcaoa "Giant."
    s fbbcaoa "Огромную."

# game/dialogs/script-topics.rpy:1804
translate ru s_topic_cupcakes_bf68c15a:

    # s abbccma "Cookie!"
    s abbccma "Печенищу!"

# game/dialogs/script-topics.rpy:1805
