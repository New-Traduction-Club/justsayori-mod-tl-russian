    # s abbbcoa "But that aside, I really wish I can visit your reality someday!"
    s abbbcoa "Но в любом случае, я очень надеюсь, что когда-нибудь смогу посетить твой мир!"

# game/dialogs/script-topics.rpy:2176
translate ru s_answer_reality_6169c02f:

    # s bbbbmoa "I wonder how I'd look, since your reality is quite different to mine..."
    s bbbbmoa "Интересно, как я буду там выглядеть? Твоя реальность во многом отличается от моей..."

# game/dialogs/script-topics.rpy:2177
