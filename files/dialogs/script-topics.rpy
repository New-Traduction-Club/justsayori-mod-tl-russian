# game/dialogs/script-topics.rpy:1906
translate ru s_answer_holidays_0a49fd9e:

    # extend abgcaoa "because I like them all!"
    extend abgcaoa "ведь я люблю их все!"

# game/dialogs/script-topics.rpy:1907
translate ru s_answer_holidays_b97f5713:

